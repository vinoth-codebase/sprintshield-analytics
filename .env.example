# =============================================================================
# SprintShield Analytics - Environment Configuration
# Copy to `.env` and edit. `cp .env.example .env`
# =============================================================================

# --- Storage backend selection -------------------------------------------------
# One of: deltalake | snowflake
STORAGE_BACKEND=deltalake

# Root directory for the local Delta Lake lakehouse (zero-setup default).
DELTA_LAKE_PATH=data/delta

# --- Jira REST API credentials -------------------------------------------------
# Leave blank to run entirely on the synthetic telemetry generator.
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=replace-me
JIRA_BOARD_ID=42
JIRA_VERIFY_SSL=true
JIRA_MAX_RETRIES=4

# --- Snowflake Cloud Data Warehouse (optional) ---------------------------------
SNOWFLAKE_ACCOUNT=xy12345.ap-south-1
SNOWFLAKE_USER=SPRINTSHIELD_SVC
SNOWFLAKE_PASSWORD=replace-me
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=SPRINTSHIELD_DB
SNOWFLAKE_SCHEMA=TELEMETRY
SNOWFLAKE_ROLE=SYSADMIN

# --- Simulation parameters -----------------------------------------------------
SIMULATION_RUNS=10000
RANDOM_SEED=20260724

# --- Reporting -----------------------------------------------------------------
REPORT_OUTPUT_DIR=reports
