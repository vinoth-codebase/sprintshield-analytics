{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SprintShield: Launch Streamlit Dashboard",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "${workspaceFolder}/src/sprintshield/dashboard/app.py",
        "--server.port=8501",
        "--server.headless=true"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "serverReadyAction": {
        "pattern": "Local URL: (http://localhost:[0-9]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "SprintShield: Run Full CLI Pipeline",
      "type": "debugpy",
      "request": "launch",
      "module": "sprintshield.cli",
      "args": [
        "simulate",
        "--gross-hours",
        "320",
        "--planned-points",
        "80"
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "SprintShield: Current Python File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "SprintShield: Pytest (current file)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${file}",
        "-vv"
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}